          }
        },
        {
          "name": "3. GET /api/notificaciones (A) → array paginado con estructura correcta",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Es un array con al menos 2 notificaciones', () => {",
            "  pm.expect(json).to.be.an('array');",
            "  pm.expect(json.length).to.be.at.least(2);",
            "});",
            "pm.test('Cada notificación tiene la estructura esperada', () => {",
            "  const n = json[0];",
            "  pm.expect(n).to.have.all.keys('id', 'tipo', 'emisor', 'titulo', 'cuerpo', 'leida', 'referenciaId', 'referenciaType', 'createdAt');",
            "  pm.expect(n.emisor).to.have.all.keys('id', 'nombre', 'nombreUsuario', 'fotoPerfil');",
            "});",
            "pm.collectionVariables.set('notificacionId1', json[0].id);",
            "pm.collectionVariables.set('notificacionId2', json[1].id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/api/notificaciones", "host": ["{{baseUrl}}"], "path": ["api", "notificaciones"] }
          }
        },
        {
          "name": "4. GET /api/notificaciones/contador (A) → número de no leídas",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Al menos 2 no leídas', () => pm.expect(json.noLeidas).to.be.at.least(2));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/api/notificaciones/contador", "host": ["{{baseUrl}}"], "path": ["api", "notificaciones", "contador"] }
          }
        },
        {
          "name": "5. PUT /api/notificaciones/{id}/leer (A) → 200",
          "event": [{ "listen": "test", "script": { "exec": [
