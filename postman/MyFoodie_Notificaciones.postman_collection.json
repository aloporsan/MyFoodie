    {
      "name": "✅ Notificaciones — Happy Path",
      "item": [
        {
          "name": "1. Setup: B sigue a A → genera nuevo_seguidor",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
