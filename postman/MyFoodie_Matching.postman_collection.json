            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ids = [1, 2, 3, 4].map(n => pm.collectionVariables.get('recetaInteraccion' + n + 'Id'));",
                  "const token = pm.collectionVariables.get('token');",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "",
                  "const acciones = [];",
                  "ids.forEach(id => { acciones.push(['like', id]); acciones.push(['guardar', id]); acciones.push(['descartar', id]); });",
                  "",
                  "const ejecutar = (i) => {",
                  "  if (i >= acciones.length) return;",
                  "  const [tipo, id] = acciones[i];",
                  "  pm.sendRequest({",
                  "    url: `${baseUrl}/api/feed/recetas/${id}/${tipo}`,",
                  "    method: 'POST',",
                  "    header: { Authorization: `Bearer ${token}` }",
                  "  }, () => ejecutar(i + 1));",
                  "};",
                  "ejecutar(0);"
                ]
              }
            }
