    {
      "name": "✅ Feed — Happy Path",
      "item": [
        {
          "name": "1. GET feed → 200 estructura paginada y coincidenciaDespensa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estructura paginada', () => {",
                  "  pm.expect(json).to.have.property('recetas');",
                  "  pm.expect(json).to.have.property('pagina');",
                  "  pm.expect(json).to.have.property('totalPaginas');",
                  "  pm.expect(json).to.have.property('hayMas');",
                  "  pm.expect(json.recetas).to.be.an('array');",
                  "});",
                  "pm.test('La receta principal aparece con coincidenciaDespensa > 0', () => {",
                  "  const receta = json.recetas.find(r => r.id === pm.collectionVariables.get('recetaId'));",
                  "  pm.expect(receta).to.not.be.undefined;",
                  "  pm.expect(receta.coincidenciaDespensa).to.be.greaterThan(0);",
                  "  pm.expect(receta).to.have.property('ingredientesDisponibles');",
                  "  pm.expect(receta).to.have.property('ingredientesFaltantes');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feed"],
              "query": [{ "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "100" }]
            }
          }
        },
        {
          "name": "2. GET feed con paginación (pagina=0, tamaño=10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Página correcta', () => pm.expect(json.pagina).to.eql(0));",
                  "pm.test('Respeta el tamaño solicitado', () => pm.expect(json.recetas.length).to.be.at.most(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feed"],
              "query": [{ "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "10" }]
            }
          }
