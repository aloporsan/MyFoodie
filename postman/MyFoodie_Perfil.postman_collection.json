{
  "info": {
    "name": "MyFoodie — Perfil API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token",   "value": "" }
  ],
  "item": [
    {
      "name": "🔧 Setup",
      "item": [
        {
          "name": "Registrar usuario principal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token guardado:', json.token.substring(0, 20) + '...');",
                  "}",
                  "pm.test('Status 201 o 409 (ya existe)', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test User\",\n  \"nombreUsuario\": \"testuser_perfil\",\n  \"email\": \"testperfil@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Registrar usuario de soporte (para test conflicto)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 o 409 (ya existe)', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro User\",\n  \"nombreUsuario\": \"otrouser_perfil\",\n  \"email\": \"otroperfil@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login usuario principal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene token', () => pm.expect(json.token).to.not.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testperfil@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "✅ Positivos",
      "item": [
        {
          "name": "1. Obtener perfil propio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene nombre', () => pm.expect(json.nombre).to.not.be.undefined);",
                  "pm.test('Tiene nombreUsuario', () => pm.expect(json.nombreUsuario).to.not.be.undefined);",
                  "pm.test('Tiene email', () => pm.expect(json.email).to.not.be.undefined);",
                  "pm.test('Tiene fechaRegistro', () => pm.expect(json.fechaRegistro).to.not.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        },
        {
          "name": "2. Editar perfil básico",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Nombre actualizado', () => pm.expect(json.nombre).to.eql('Test User Editado'));",
                  "pm.test('Biografía actualizada', () => pm.expect(json.biografia).to.eql('Mi bio de prueba'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test User Editado\",\n  \"biografia\": \"Mi bio de prueba\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        },
        {
          "name": "3. Obtener preferencias",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene tipoDieta', () => pm.expect(json).to.have.property('tipoDieta'));",
                  "pm.test('Tiene alergias', () => pm.expect(json).to.have.property('alergias'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/perfil/preferencias", "host": ["{{baseUrl}}"], "path": ["api", "perfil", "preferencias"] }
          }
        },
        {
          "name": "4. Actualizar preferencias",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('TipoDieta actualizado', () => pm.expect(json.tipoDieta).to.eql('vegetariano'));",
                  "pm.test('Alergias actualizadas', () => pm.expect(json.alergias).to.include('gluten'));",
                  "pm.test('NivelDificultad actualizado', () => pm.expect(json.nivelDificultad).to.eql('medio'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoDieta\": \"vegetariano\",\n  \"alergias\": [\"gluten\"],\n  \"nivelDificultad\": \"medio\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/perfil/preferencias", "host": ["{{baseUrl}}"], "path": ["api", "perfil", "preferencias"] }
          }
        },
        {
          "name": "5. Actualizar privacidad",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perfilPublico\": true,\n  \"mostrarRecetas\": true,\n  \"mostrarEstadisticas\": false,\n  \"permitirMensajes\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/perfil/privacidad", "host": ["{{baseUrl}}"], "path": ["api", "perfil", "privacidad"] }
          }
        },
        {
          "name": "6. Obtener estadísticas del perfil",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene totalProductosRegistrados', () => pm.expect(json.totalProductosRegistrados).to.be.a('number'));",
                  "pm.test('Tiene totalProductosConsumidos',  () => pm.expect(json.totalProductosConsumidos).to.be.a('number'));",
                  "pm.test('Tiene totalProductosCaducados',   () => pm.expect(json.totalProductosCaducados).to.be.a('number'));",
                  "pm.test('Tiene totalRecetasPublicadas',    () => pm.expect(json.totalRecetasPublicadas).to.be.a('number'));",
                  "pm.test('Tiene totalRecetasGuardadas',     () => pm.expect(json.totalRecetasGuardadas).to.be.a('number'));",
                  "pm.test('Tiene fechaRegistro',             () => pm.expect(json.fechaRegistro).to.not.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/perfil/estadisticas", "host": ["{{baseUrl}}"], "path": ["api", "perfil", "estadisticas"] }
          }
        }
      ]
    },
    {
      "name": "❌ Negativos",
      "item": [
        {
          "name": "Re-login (token fresco para negativos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testperfil@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "7. GET perfil sin token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        },
        {
          "name": "8. PUT perfil con nombreUsuario duplicado → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Mensaje duplicado', () => pm.expect(pm.response.json().message).to.include('uso'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"otrouser_perfil\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        },
        {
          "name": "9. DELETE cuenta sin campo confirmar → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        },
        {
          "name": "10. DELETE cuenta con confirmar: false → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de confirmación requerida', () => pm.expect(pm.response.json().message).to.not.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmar\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        },
        {
          "name": "11. Cerrar sesión (invalida token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', '');",
                  "console.log('Token eliminado de la colección');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/perfil/cerrar-sesion", "host": ["{{baseUrl}}"], "path": ["api", "perfil", "cerrar-sesion"] }
          }
        }
      ]
    }
  ]
}
