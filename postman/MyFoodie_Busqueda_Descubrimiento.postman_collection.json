    {
      "name": "🏷️ Filtros de feed (#37)",
      "item": [
        {
          "name": "GET /api/feed?etiqueta=vegano → solo R2 (case-insensitive)",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const ids = json.recetas.map(r => r.id);",
            "pm.test('Incluye R2', () => pm.expect(ids).to.include(pm.collectionVariables.get('r2')));",
            "pm.test('Todas llevan etiqueta vegano', () => json.recetas.forEach(r => pm.expect(r.etiquetas.map(e=>e.toLowerCase())).to.include('vegano')));"
          ] } } ],
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/feed?tamaño=50&etiqueta=vegano", "host": ["{{baseUrl}}"], "path": ["api", "feed"], "query": [ { "key": "tamaño", "value": "50" }, { "key": "etiqueta", "value": "vegano" } ] } }
        },
        {
          "name": "GET /api/feed?etiqueta=saludable&dificultad=Fácil → R1 y R5, no R2",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const ids = json.recetas.map(r => r.id);",
            "pm.test('Incluye R1 y R5', () => { pm.expect(ids).to.include(pm.collectionVariables.get('r1')); pm.expect(ids).to.include(pm.collectionVariables.get('r5')); });",
            "pm.test('No incluye R2 (Media)', () => pm.expect(ids).to.not.include(pm.collectionVariables.get('r2')));"
          ] } } ],
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/feed?tamaño=50&etiqueta=saludable&dificultad=Fácil", "host": ["{{baseUrl}}"], "path": ["api", "feed"], "query": [ { "key": "tamaño", "value": "50" }, { "key": "etiqueta", "value": "saludable" }, { "key": "dificultad", "value": "Fácil" } ] } }
        },
        {
          "name": "GET /api/feed?categoria=Postre → solo R3",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('Todas son Postre', () => json.recetas.forEach(r => pm.expect(r.categoria).to.eql('Postre')));",
            "pm.test('Incluye R3', () => pm.expect(json.recetas.map(r=>r.id)).to.include(pm.collectionVariables.get('r3')));"
          ] } } ],
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/feed?tamaño=50&categoria=Postre", "host": ["{{baseUrl}}"], "path": ["api", "feed"], "query": [ { "key": "tamaño", "value": "50" }, { "key": "categoria", "value": "Postre" } ] } }
        },
        {
          "name": "GET /api/feed?tiempo=0-15 → R4 (15) y R5 (10)",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('Ningún resultado supera 15 min', () => json.recetas.forEach(r => pm.expect(r.tiempoEstimado).to.be.at.most(15)));",
            "const ids = json.recetas.map(r => r.id);",
            "pm.test('Incluye R4 y R5', () => { pm.expect(ids).to.include(pm.collectionVariables.get('r4')); pm.expect(ids).to.include(pm.collectionVariables.get('r5')); });"
          ] } } ],
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/feed?tamaño=50&tiempo=0-15", "host": ["{{baseUrl}}"], "path": ["api", "feed"], "query": [ { "key": "tamaño", "value": "50" }, { "key": "tiempo", "value": "0-15" } ] } }
        },
        {
          "name": "GET /api/feed?personas=3-4 → R2 y R5",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('Todas para 3-4 personas', () => json.recetas.forEach(r => pm.expect(r.numPersonas).to.be.within(3,4)));"
