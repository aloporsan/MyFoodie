{
  "info": {
    "name": "MyFoodie — Búsqueda y descubrimiento (Fase 3 Bloque 5)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:8080" },
    { "key": "token",       "value": "" },
    { "key": "tokenAutor",  "value": "" },
    { "key": "emailBuscador", "value": "" },
    { "key": "emailAutor",  "value": "" },
    { "key": "r1", "value": "" },
    { "key": "r2", "value": "" },
    { "key": "r3", "value": "" },
    { "key": "r4", "value": "" },
    { "key": "r5", "value": "" }
  ],
  "item": [
    {
      "name": "🔧 Setup",
      "item": [
        {
          "name": "Registrar usuario autor (publica las recetas)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "pm.collectionVariables.set('emailAutor', 'bd_autor_' + Date.now() + '@test.com');"
              ] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "if (json.token) pm.collectionVariables.set('tokenAutor', json.token);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Tiene token', () => pm.expect(json.token).to.not.be.empty);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Autor Recetas\",\n  \"nombreUsuario\": \"bd_autor_{{$timestamp}}\",\n  \"email\": \"{{emailAutor}}\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Registrar usuario buscador (consulta feed y buscador)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "pm.collectionVariables.set('emailBuscador', 'bd_buscador_' + Date.now() + '@test.com');"
              ] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "if (json.token) pm.collectionVariables.set('token', json.token);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Usuario Buscador\",\n  \"nombreUsuario\": \"bd_buscador_{{$timestamp}}\",\n  \"email\": \"{{emailBuscador}}\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        }
      ]
    },
