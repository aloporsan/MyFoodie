    {
      "name": "🏷️ Filtro de feed por etiqueta (#37)",
      "item": [
        {
          "name": "GET /api/feed?etiqueta=Vegana → solo recetas con esa etiqueta",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Todas las recetas devueltas llevan la etiqueta Vegana', () => {",
            "  pm.expect(json.recetas).to.be.an('array').that.is.not.empty;",
            "  json.recetas.forEach(r => pm.expect(r.etiquetas).to.include('Vegana'));",
            "});",
            "pm.test('Incluye el Curry vegano de garbanzos', () => {",
            "  pm.expect(json.recetas.map(r => r.id)).to.include(pm.collectionVariables.get('r2'));",
            "});"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=50&etiqueta=Vegana",
              "host": ["{{baseUrl}}"], "path": ["api", "feed"],
              "query": [ { "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "50" }, { "key": "etiqueta", "value": "Vegana" } ]
            }
          }
        },
        {
          "name": "GET /api/feed?etiqueta=Saludable → varias recetas, todas con la etiqueta",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Todas llevan la etiqueta Saludable', () => {",
            "  pm.expect(json.recetas).to.be.an('array').that.is.not.empty;",
            "  json.recetas.forEach(r => pm.expect(r.etiquetas).to.include('Saludable'));",
            "});",
            "pm.test('No aparece el Curry vegano (etiqueta distinta)', () => {",
            "  pm.expect(json.recetas.map(r => r.id)).to.not.include(pm.collectionVariables.get('r2'));",
            "});"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=50&etiqueta=Saludable",
              "host": ["{{baseUrl}}"], "path": ["api", "feed"],
              "query": [ { "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "50" }, { "key": "etiqueta", "value": "Saludable" } ]
            }
          }
        },
        {
          "name": "GET /api/feed (sin etiqueta) → devuelve recetas de varias etiquetas",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Aparecen recetas de al menos 2 etiquetas distintas', () => {",
            "  const ids = json.recetas.map(r => r.id);",
            "  pm.expect(ids).to.include(pm.collectionVariables.get('r1'));",
            "  pm.expect(ids).to.include(pm.collectionVariables.get('r2'));",
            "});"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=50",
              "host": ["{{baseUrl}}"], "path": ["api", "feed"],
              "query": [ { "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "50" } ]
            }
          }
        },
        {
          "name": "GET /api/feed?etiqueta=NoExiste → feed vacío",
          "event": [ { "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('No hay resultados para una etiqueta inexistente', () => {",
            "  pm.expect(json.recetas).to.be.an('array').that.is.empty;",
            "});"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=50&etiqueta=NoExiste",
              "host": ["{{baseUrl}}"], "path": ["api", "feed"],
              "query": [ { "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "50" }, { "key": "etiqueta", "value": "NoExiste" } ]
            }
          }
        }
      ]
    },
