{
  "info": {
    "name": "MyFoodie — Social Avanzado (Fase 3 Bloque 4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Verificación manual del backend del Bloque 4: comentarios (#72), reportes genéricos (#73), visibilidad de recetas y filtrado de feed por bloqueo (#99, #100). La trazabilidad de interacciones (#101) no expone endpoints (hooks internos)."
  },
  "variable": [
    { "key": "baseUrl",             "value": "http://localhost:8080" },
    { "key": "autorEmail",          "value": "" },
    { "key": "lectorEmail",         "value": "" },
    { "key": "tokenAutor",          "value": "" },
    { "key": "idAutor",             "value": "" },
    { "key": "tokenLector",         "value": "" },
    { "key": "idLector",            "value": "" },
    { "key": "recetaPublicaId",     "value": "" },
    { "key": "recetaSeguidoresId",  "value": "" },
    { "key": "recetaPrivadaId",     "value": "" },
    { "key": "comentarioId",        "value": "" },
    { "key": "comentarioReporteId", "value": "" }
  ],
  "item": [
    {
      "name": "🔧 Setup",
      "item": [
        {
          "name": "Registrar Autor",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "pm.collectionVariables.set('autorEmail', 'sa_autor_' + Date.now() + '@test.com');"
              ] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "if (json.token) pm.collectionVariables.set('tokenAutor', json.token);",
                "if (json.userId) pm.collectionVariables.set('idAutor', json.userId);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Devuelve token y userId', () => {",
                "  pm.expect(json.token).to.not.be.empty;",
                "  pm.expect(json.userId).to.not.be.empty;",
                "});"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Autor Social\",\n  \"nombreUsuario\": \"sa_autor_{{$timestamp}}\",\n  \"email\": \"{{autorEmail}}\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Registrar Lector",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "pm.collectionVariables.set('lectorEmail', 'sa_lector_' + Date.now() + '@test.com');"
              ] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "if (json.token) pm.collectionVariables.set('tokenLector', json.token);",
                "if (json.userId) pm.collectionVariables.set('idLector', json.userId);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Lector Social\",\n  \"nombreUsuario\": \"sa_lector_{{$timestamp}}\",\n  \"email\": \"{{lectorEmail}}\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Autor: crear receta PÚBLICA",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('visibilidad por defecto PUBLICA', () => pm.expect(json.visibilidad).to.eql('PUBLICA'));",
                "pm.test('numeroComentarios arranca en 0', () => pm.expect(json.numeroComentarios).to.eql(0));",
                "pm.collectionVariables.set('recetaPublicaId', json.id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAutor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Receta pública de prueba\",\n  \"descripcion\": \"Para comentarios y reportes\",\n  \"tiempoEstimado\": 20,\n  \"dificultad\": \"fácil\",\n  \"categoria\": \"principal\",\n  \"etiquetas\": [\"test\"]\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas", "host": ["{{baseUrl}}"], "path": ["api", "recetas"] }
          }
        },
        {
          "name": "Autor: ingrediente en receta pública",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAutor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"harina\",\n  \"cantidad\": 200,\n  \"unidad\": \"g\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/ingredientes", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "ingredientes"] }
          }
        },
        {
          "name": "Autor: paso en receta pública",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAutor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"Mezclar todo y hornear\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/pasos", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "pasos"] }
          }
        },
        {
          "name": "Autor: publicar receta pública",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAutor}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/publicar", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "publicar"] }
          }
        },
        {
          "name": "Autor: crear receta SOLO_SEGUIDORES",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('visibilidad SOLO_SEGUIDORES', () => pm.expect(json.visibilidad).to.eql('SOLO_SEGUIDORES'));",
                "pm.collectionVariables.set('recetaSeguidoresId', json.id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAutor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Receta solo para seguidores\",\n  \"descripcion\": \"No debe verse sin seguir al autor\",\n  \"tiempoEstimado\": 15,\n  \"dificultad\": \"fácil\",\n  \"categoria\": \"principal\",\n  \"etiquetas\": [\"test\"],\n  \"visibilidad\": \"SOLO_SEGUIDORES\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas", "host": ["{{baseUrl}}"], "path": ["api", "recetas"] }
          }
        },
        {
          "name": "Autor: ingrediente en receta seguidores",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAutor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"arroz\",\n  \"cantidad\": 100,\n  \"unidad\": \"g\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaSeguidoresId}}/ingredientes", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaSeguidoresId}}", "ingredientes"] }
          }
        },
        {
          "name": "Autor: paso en receta seguidores",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAutor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"Cocer el arroz\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaSeguidoresId}}/pasos", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaSeguidoresId}}", "pasos"] }
          }
        },
        {
          "name": "Autor: publicar receta seguidores",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAutor}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaSeguidoresId}}/publicar", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaSeguidoresId}}", "publicar"] }
          }
        },
        {
          "name": "Autor: crear receta PRIVADA",
          "event": [
            {
