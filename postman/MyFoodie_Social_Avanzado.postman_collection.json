              "script": { "exec": [
                "const json = pm.response.json();",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('visibilidad PRIVADA', () => pm.expect(json.visibilidad).to.eql('PRIVADA'));",
                "pm.collectionVariables.set('recetaPrivadaId', json.id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAutor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Receta privada\",\n  \"descripcion\": \"Solo la ve el autor\",\n  \"tiempoEstimado\": 10,\n  \"dificultad\": \"fácil\",\n  \"categoria\": \"principal\",\n  \"etiquetas\": [\"test\"],\n  \"visibilidad\": \"PRIVADA\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas", "host": ["{{baseUrl}}"], "path": ["api", "recetas"] }
          }
        },
        {
          "name": "Autor: ingrediente en receta privada",
