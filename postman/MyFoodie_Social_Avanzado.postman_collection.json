      ]
    },
    {
      "name": "✅ Comentarios (#72)",
      "item": [
        {
          "name": "Lector: POST comentario en receta pública → 201",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('esAutor true para quien lo escribe', () => pm.expect(json.esAutor).to.eql(true));",
                "pm.test('devuelve texto e id', () => {",
                "  pm.expect(json.id).to.not.be.empty;",
                "  pm.expect(json.texto).to.eql('¡Qué buena pinta!');",
                "});",
                "pm.collectionVariables.set('comentarioId', json.id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenLector}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"texto\": \"¡Qué buena pinta!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/comentarios", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "comentarios"] }
          }
        },
        {
          "name": "GET comentarios → 200, lista con 1, más reciente primero",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Un comentario', () => pm.expect(json).to.be.an('array').with.lengthOf(1));",
                "pm.test('esAutor false para el autor de la receta', () => pm.expect(json[0].esAutor).to.eql(false));"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAutor}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/comentarios", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "comentarios"] }
          }
        },
        {
          "name": "Autor: GET receta → numeroComentarios == 1",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('numeroComentarios == 1', () => pm.expect(json.numeroComentarios).to.eql(1));"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAutor}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}"] }
          }
        },
        {
          "name": "POST comentario vacío → 400",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenLector}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"texto\": \"   \"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/comentarios", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "comentarios"] }
          }
        },
        {
          "name": "POST comentario en receta inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenLector}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"texto\": \"comentario huérfano\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/recetas/000000000000000000000000/comentarios", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "000000000000000000000000", "comentarios"] }
          }
        },
        {
          "name": "Autor: DELETE comentario ajeno → 404 (no es su comentario)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAutor}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/comentarios/{{comentarioId}}", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "comentarios", "{{comentarioId}}"] }
          }
        },
        {
          "name": "Lector: DELETE su comentario → 204",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenLector}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/comentarios/{{comentarioId}}", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "comentarios", "{{comentarioId}}"] }
          }
        },
        {
          "name": "GET comentarios tras borrado lógico → 200, lista vacía",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "const json = pm.response.json();",
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Sin comentarios visibles', () => pm.expect(json).to.be.an('array').that.is.empty);"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAutor}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/comentarios", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "comentarios"] }
          }
        },
        {
          "name": "GET comentarios sin token → 401",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaPublicaId}}/comentarios", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaPublicaId}}", "comentarios"] }
          }
        }
      ]
    },
