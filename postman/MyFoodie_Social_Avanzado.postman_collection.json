            "url": { "raw": "{{baseUrl}}/api/reportes", "host": ["{{baseUrl}}"], "path": ["api", "reportes"] }
          }
        },
        {
          "name": "Autor: POST reporte de COMENTARIO (motivo OTRO + descripción) → 201",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
