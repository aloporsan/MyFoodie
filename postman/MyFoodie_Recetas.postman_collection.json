    {
      "name": "✅ Positivos",
      "item": [
        {
          "name": "1. Crear receta (borrador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Estado borrador', () => pm.expect(json.estado).to.eql('borrador'));",
                  "pm.test('Tiene id', () => pm.expect(json.id).to.not.be.empty);",
                  "pm.collectionVariables.set('recetaId', json.id);",
                  "console.log('recetaId guardado:', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Tortilla española\",\n  \"descripcion\": \"Receta clásica de tortilla de patatas\",\n  \"tiempoEstimado\": 30,\n  \"dificultad\": \"medio\",\n  \"categoria\": \"plato principal\",\n  \"etiquetas\": [\"Vegetariana\", \"Económica\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/recetas", "host": ["{{baseUrl}}"], "path": ["api", "recetas"] }
          }
        },
        {
          "name": "2. Obtener receta completa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ID correcto', () => pm.expect(json.id).to.eql(pm.collectionVariables.get('recetaId')));",
                  "pm.test('Tiene ingredientes', () => pm.expect(json.ingredientes).to.be.an('array'));",
                  "pm.test('Tiene pasos', () => pm.expect(json.pasos).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaId}}", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaId}}"] }
          }
        },
        {
          "name": "3. Editar receta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Título actualizado', () => pm.expect(json.titulo).to.eql('Tortilla española mejorada'));",
                  "pm.test('Tiempo actualizado', () => pm.expect(json.tiempoEstimado).to.eql(45));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Tortilla española mejorada\",\n  \"descripcion\": \"Versión mejorada con cebolla caramelizada\",\n  \"tiempoEstimado\": 45,\n  \"dificultad\": \"medio\",\n  \"categoria\": \"plato principal\",\n  \"etiquetas\": [\"Vegetariana\", \"Económica\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/recetas/{{recetaId}}", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "{{recetaId}}"] }
          }
        },
        {
          "name": "4. Añadir ingrediente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
