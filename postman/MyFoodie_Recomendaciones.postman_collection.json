    {
      "name": "✅ Feed con Recomendaciones",
      "item": [
        {
          "name": "GET feed → verifica motivoRecomendacion y contextoSocial",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Las recetas incluyen motivoRecomendacion y contextoSocial', () => {",
                  "  pm.expect(json.recetas).to.be.an('array').that.is.not.empty;",
                  "  json.recetas.forEach(r => {",
                  "    pm.expect(r).to.have.property('motivoRecomendacion');",
                  "    pm.expect(r).to.have.property('contextoSocial');",
                  "    pm.expect(r.contextoSocial).to.have.property('publicadaPorSeguido');",
                  "    pm.expect(r.contextoSocial).to.have.property('seguidosQueDieronLike');",
                  "    pm.expect(r.contextoSocial).to.have.property('compartidaContigo');",
                  "  });",
                  "});",
                  "pm.test('La receta principal está marcada como publicada por un seguido', () => {",
                  "  const receta = json.recetas.find(r => r.id === pm.collectionVariables.get('recetaId'));",
                  "  pm.expect(receta).to.not.be.undefined;",
                  "  pm.expect(receta.publicadaPorSeguido).to.be.true;",
                  "  pm.expect(receta.contextoSocial.publicadaPorSeguido).to.be.true;",
                  "  pm.expect(receta.contextoSocial.textoContexto).to.eql('Publicado por alguien que sigues');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feed"],
              "query": [{ "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "50" }]
            }
          }
        },
        {
          "name": "GET perfil-gustos → verifica estructura",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estructura del perfil de gustos', () => {",
                  "  pm.expect(json).to.have.property('categoriasPreferidas');",
                  "  pm.expect(json).to.have.property('etiquetasPreferidas');",
                  "  pm.expect(json).to.have.property('dificultadesPreferidas');",
                  "  pm.expect(json.categoriasPreferidas).to.be.an('object');",
                  "  pm.expect(json.etiquetasPreferidas).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/feed/perfil-gustos", "host": ["{{baseUrl}}"], "path": ["api", "feed", "perfil-gustos"] }
          }
        },
        {
          "name": "GET recetas-seguidos → solo recetas de seguidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
