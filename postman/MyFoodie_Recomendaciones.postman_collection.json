            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('tokenAutor', json.token);",
                  "if (json.userId) pm.collectionVariables.set('autorId', json.userId);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene token y userId', () => {",
