                  "  json.recetas.forEach(r => pm.expect(r.autorId).to.eql(pm.collectionVariables.get('autorId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/feed/recetas-seguidos?pagina=0&tamaño=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feed", "recetas-seguidos"],
              "query": [{ "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "50" }]
            }
          }
        },
        {
          "name": "POST descartar receta secundaria (setup limpieza)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/feed/recetas/{{recetaIdDescartar}}/descartar", "host": ["{{baseUrl}}"], "path": ["api", "feed", "recetas", "{{recetaIdDescartar}}", "descartar"] }
          }
        },
        {
          "name": "GET feed → la receta descartada no aparece",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('No incluye la receta descartada', () => {",
                  "  const id = pm.collectionVariables.get('recetaIdDescartar');",
                  "  pm.expect(json.recetas.some(r => r.id === id)).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feed"],
              "query": [{ "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "50" }]
            }
          }
        },
        {
          "name": "DELETE descartadas → limpia el historial",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/feed/descartadas", "host": ["{{baseUrl}}"], "path": ["api", "feed", "descartadas"] }
          }
        },
        {
          "name": "GET feed → la receta reaparece tras limpiar descartadas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('La receta vuelve a aparecer', () => {",
                  "  const id = pm.collectionVariables.get('recetaIdDescartar');",
                  "  pm.expect(json.recetas.some(r => r.id === id)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/feed?pagina=0&tamaño=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feed"],
              "query": [{ "key": "pagina", "value": "0" }, { "key": "tamaño", "value": "50" }]
            }
          }
        }
      ]
    },
