    {
      "name": "✅ Compartir — Happy Path",
      "item": [
        {
          "name": "1. POST compartir con un receptor → 201",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Array con 1 elemento', () => {",
            "  pm.expect(json).to.be.an('array');",
            "  pm.expect(json.length).to.eql(1);",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenEmisor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"receptorIds\": [\"{{idReceptor2}}\"]\n}" },
            "url": { "raw": "{{baseUrl}}/api/compartir/recetas/{{recetaId}}", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recetas", "{{recetaId}}"] }
          }
        },
        {
          "name": "2. POST compartir con varios receptores → 201",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Array con 2 elementos', () => {",
            "  pm.expect(json).to.be.an('array');",
            "  pm.expect(json.length).to.eql(2);",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenEmisor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"receptorIds\": [\"{{idReceptor1}}\", \"{{idReceptor2}}\"]\n}" },
            "url": { "raw": "{{baseUrl}}/api/compartir/recetas/{{recetaId}}", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recetas", "{{recetaId}}"] }
          }
        },
        {
          "name": "3. POST compartir con mensaje → mensaje guardado",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Mensaje guardado correctamente', () => {",
            "  pm.expect(json[0].mensaje).to.eql('Esta receta te puede gustar para la cena.');",
            "  pm.expect(json[0].leida).to.be.false;",
            "  pm.expect(json[0].emisor.nombreUsuario).to.eql('compartiremisor');",
            "  pm.expect(json[0].receta.id).to.eql(pm.collectionVariables.get('recetaId'));",
            "});",
            "pm.collectionVariables.set('recetaCompartidaId', json[0].id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenEmisor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"receptorIds\": [\"{{idReceptor1}}\"],\n  \"mensaje\": \"Esta receta te puede gustar para la cena.\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/compartir/recetas/{{recetaId}}", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recetas", "{{recetaId}}"] }
          }
        },
        {
          "name": "4. GET recibidas → array con datos de emisor y receta completa",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Contiene la receta compartida con datos completos', () => {",
            "  pm.expect(json).to.be.an('array');",
            "  const item = json.find(r => r.id === pm.collectionVariables.get('recetaCompartidaId'));",
            "  pm.expect(item).to.not.be.undefined;",
            "  pm.expect(item.emisor.nombreUsuario).to.eql('compartiremisor');",
            "  pm.expect(item.receta.ingredientes).to.be.an('array');",
            "  pm.expect(item.mensaje).to.eql('Esta receta te puede gustar para la cena.');",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenReceptor1}}" }],
            "url": { "raw": "{{baseUrl}}/api/compartir/recibidas", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recibidas"] }
          }
        },
        {
          "name": "5. GET contador → número de no leídas",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Al menos 2 no leídas (paso 2 y 3)', () => {",
            "  pm.expect(json.noLeidas).to.be.at.least(2);",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenReceptor1}}" }],
            "url": { "raw": "{{baseUrl}}/api/compartir/recibidas/contador", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recibidas", "contador"] }
          }
        },
        {
          "name": "6. PUT leer → marca como leída",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenReceptor1}}" }],
            "url": { "raw": "{{baseUrl}}/api/compartir/recibidas/{{recetaCompartidaId}}/leer", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recibidas", "{{recetaCompartidaId}}", "leer"] }
          }
        },
        {
          "name": "7. GET recibidas → confirma campo leida true",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('leida es true tras marcarla', () => {",
            "  const item = json.find(r => r.id === pm.collectionVariables.get('recetaCompartidaId'));",
            "  pm.expect(item.leida).to.be.true;",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenReceptor1}}" }],
            "url": { "raw": "{{baseUrl}}/api/compartir/recibidas", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recibidas"] }
          }
        },
        {
          "name": "8. POST guardar → aparece en recetas guardadas",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenReceptor1}}" }],
            "url": { "raw": "{{baseUrl}}/api/compartir/recibidas/{{recetaCompartidaId}}/guardar", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recibidas", "{{recetaCompartidaId}}", "guardar"] }
          }
        },
        {
          "name": "9. GET recetas guardadas → confirma que aparece la receta compartida",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('La receta compartida está en guardadas', () => {",
            "  pm.expect(json.some(r => r.id === pm.collectionVariables.get('recetaId'))).to.be.true;",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenReceptor1}}" }],
            "url": { "raw": "{{baseUrl}}/api/recetas/guardadas", "host": ["{{baseUrl}}"], "path": ["api", "recetas", "guardadas"] }
          }
        },
        {
          "name": "10. GET ingredientes → lista de faltantes",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Devuelve lista de ingredientes faltantes', () => {",
            "  pm.expect(json).to.be.an('array');",
            "  pm.expect(json.some(i => i.nombre === 'Tomate')).to.be.true;",
            "  pm.expect(json[0]).to.have.property('cantidad');",
            "  pm.expect(json[0]).to.have.property('unidad');",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenReceptor1}}" }],
            "url": { "raw": "{{baseUrl}}/api/compartir/recibidas/{{recetaCompartidaId}}/ingredientes", "host": ["{{baseUrl}}"], "path": ["api", "compartir", "recibidas", "{{recetaCompartidaId}}", "ingredientes"] }
          }
        }
      ]
    },
