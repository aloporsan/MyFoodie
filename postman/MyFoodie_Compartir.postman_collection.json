            "pm.test('Status 201 o 409 (ya existe)', () => pm.expect([201, 409]).to.include(pm.response.code));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Compartir Emisor\",\n  \"nombreUsuario\": \"compartiremisor\",\n  \"email\": \"compartir_emisor@test.com\",\n  \"password\": \"password123\"\n}" },
